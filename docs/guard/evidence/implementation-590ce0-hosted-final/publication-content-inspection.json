{
  "heuristic_only": true,
  "matches": [],
  "patterns": {
    "cloud_key": "AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}",
    "github_token": "gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}",
    "private_key": "BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY",
    "signed_query": "[?&](?:sig|token|access_token|password)="
  },
  "schema": "hol-guard.hosted-publication-content-inspection.v1",
  "scope": "Authenticated GitHub metadata, decoded job logs, archive JSON and exact shard node plan; no private fixture journals or signed download URLs included"
}
