      "input": "store._authority_key(required=False), initial marker or retained authenticated prior ID"
    },
    {
      "path": "src/codex_plugin_scanner/guard/native_command_control_authority_store.py",
      "line": 205,
      "input": "new_authority_key from the sole production recovery caller"
    },
    {
      "path": "src/codex_plugin_scanner/guard/native_command_control_authority_store.py",
      "line": 221,
      "input": "store._authority_key(required=False), committed projection"
    },
    {
      "path": "src/codex_plugin_scanner/guard/native_command_control_authority_store.py",
      "line": 250,
      "input": "store._authority_key(required=False), unchanged committed projection validation"
    }
  ],
  "key_provenance": [
    {
      "path": "src/codex_plugin_scanner/guard/store_extension_control_authority.py",
      "line": 286,
      "fact": "Enrollment calls _bootstrap_extension_control_authority with key=None after validating and consuming the enrollment proof under the authority lock."
    },
    {
      "path": "src/codex_plugin_scanner/guard/store_extension_control_authority.py",
      "line": 1271,
      "fact": "Bootstrap creates secrets.token_bytes(32) when missing and persists a URL-safe base64 encoding under the scoped key reference."
    },
    {
      "path": "src/codex_plugin_scanner/guard/store_extension_control_authority.py",
      "line": 568,
      "fact": "Recovery obtains the existing key from _authority_key; all _reset_extension_control_authority calls pass this value or None."
    },
    {
      "path": "src/codex_plugin_scanner/guard/store_extension_control_authority.py",
      "line": 673,
      "fact": "Reset reuses the validated existing key or generates secrets.token_bytes(32), calls begin_native_command_control_recovery, then bootstraps with the same recovered key."
    },
    {
      "path": "src/codex_plugin_scanner/guard/store_extension_control_authority_support.py",
      "line": 131,
      "fact": "_authority_key reads only the scoped authority SecretStore reference, decodes base64, rejects missing required values or decoded length other than 32."
    },
    {
      "path": "src/codex_plugin_scanner/guard/store_extension_control_authority_support.py",
      "line": 159,
      "fact": "The default authority store uses EncryptedFileSecretStore with an optional SystemKeyringSecretStore legacy source; new values always reach the local fallback through MigratingFallbackSecretStore."
    },
    {
      "path": "src/codex_plugin_scanner/guard/store_base.py",
      "line": 887,
      "fact": "The current local store uses Fernet encryption with mode 0700 for the secrets directory and mode 0600 for key and encrypted values; the key shares the same per-user directory."
    }
  ],
  "authentication_and_consumers": [
    {
      "path": "src/codex_plugin_scanner/guard/native_command_control_authority.py",
      "line": 106,
      "fact": "_record_mac computes HMAC-SHA256 over the domain plus canonical record fields; decode_authority checks exact canonical bytes and uses hmac.compare_digest."
    },
    {
      "path": "src/codex_plugin_scanner/guard/native_command_control_authority_store.py",
      "line": 51,
      "fact": "The marker HMAC verifier is derived from separately loaded policy-integrity key material, not from the authority key ID."
    },
    {
      "path": "src/codex_plugin_scanner/guard/native_policy_snapshot_codec.py",
      "line": 141,
      "fact": "The 32-byte verifier is derived using HMAC-SHA256 with a dedicated domain from the 32-byte policy-integrity master key."
    },
    {
      "path": "src/codex_plugin_scanner/guard/native_command_control_authority_store.py",
      "line": 224,
      "fact": "An unexpected key ID change in an existing nonzero epoch is rejected; committed reads also compare phase, effective digest, and current key ID."
    },
    {
      "path": "rust/crates/guard-runtime/src/policy_store_command_authority.rs",
      "line": 127,
      "fact": "Rust verifies the complete canonical marker HMAC with ring::hmac::verify and checks the committed phase, effective digest, and full expected authority binding under a shared mutation lease."
    },
    {
      "path": "rust/crates/guard-runtime/src/policy_store_command_floor.rs",
      "line": 93,
      "fact": "Rust floor transitions reject a changed key ID within the same epoch and require exact authenticated predecessor context for a recovery epoch."
    }
  ],
