  "groups": {
    "authority-marker-guard": {
      "rule": "pythonbugs:S2583",
      "reason": "The optional value comes from a bounded owner-only marker-file read and authenticated decode. Missing, closed, changed effective digest, and changed authority key each require mutation; matching committed state returns the validated authority binding. Six regressions exercise real signed marker files through this function with a fixed test key provider, including invalid-MAC refusal. These conditions are not constants; removing them would permit stale or unmatched authority."
    },
    "network-risk-token": {
      "rule": "python:S5332",
      "reason": "The HTTP string is a literal token in an outbound-network risk detector. It is matched against tool-call text and does not create a network connection. Replacing it with HTTPS would remove recognition of cleartext HTTP inputs from the security classifier."
    },
    "loopback-server": {
      "rule": "python:S5332",
      "reason": "The flagged call binds the existing local daemon HTTP listener. GuardDaemonServer defaults to 127.0.0.1, and BoundedThreadingHTTPServer.verify_request rejects every non-loopback peer before request dispatch. The server_bind override avoids reverse-DNS metadata lookup and adds no external cleartext transport. Review applies only while the local-peer restriction and authenticated handler boundary remain intact."
    },
    "matcher-input-http": {
      "rule": "python:S5332",
      "reason": "These HTTP strings are inert command-parser fixture inputs, including invalid authorities, ports, IPv6, Unicode, control characters and quoting. add() constructs canonical command objects and invokes matcher.match; it does not execute curl or issue a request. HTTP and HTTPS behavior must both remain covered."
    },
    "matcher-input-prng": {
      "rule": "python:S2245",
      "reason": "Fixed random.Random seeds 32029 and 320109 generate finite deterministic parser argument samples. They generate no credential, nonce, key, security token or runtime identifier. The fixtures are serialized to checked-in JSON and --check requires exact reproducibility; replacing the generator with a CSPRNG would break this contract without improving security."
    }
  },
