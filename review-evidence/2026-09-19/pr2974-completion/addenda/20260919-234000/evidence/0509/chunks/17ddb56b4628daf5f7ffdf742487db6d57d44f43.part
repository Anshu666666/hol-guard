        "string_literals": [
          "'Current Pi and OMP ownership boundaries after legacy migration removal.'",
          "'agent'",
          "'settings.json'",
          "'extensions'",
          "'hol-guard.ts'",
          "'user-extension.ts'",
          "'Pi'",
