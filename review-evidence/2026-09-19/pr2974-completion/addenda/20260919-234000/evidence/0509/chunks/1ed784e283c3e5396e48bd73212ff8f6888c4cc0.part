        "string_literals": [
          "'Exercise live fixture selection through the actual profiler send boundary.'",
          "'module_name'",
          "'variant'",
          "'profile_guard_mcp_session'",
          "'owned'",
          "'profile_guard_mcp_streaming_session'",
          "'streaming'",
