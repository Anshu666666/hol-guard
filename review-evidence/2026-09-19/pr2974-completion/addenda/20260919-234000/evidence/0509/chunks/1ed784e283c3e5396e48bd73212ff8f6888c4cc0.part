          "'id'",
          "'result'",
          "'fixture_arguments'",
          "'early'",
          "'Popen'",
          "'tree_sample'",
          "'_readline_with_timeout'",
          "'retire_reader'",
          "'stage'",
          "'tool_call'",
          "'attempted_tool_requests'",
          "'observed_tool_responses'",
          "'accepted'",
          "'errors'",
          "'method'",
          "'tools/call'",
          "'id'",
