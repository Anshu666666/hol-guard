        "string_literals": [
          "'Private mixed-scenario controls for an actual installed daemon fixture.\\n\\nControls use production settings, policy publication, inventory persistence and\\nresident containment. Enforcing probes use authenticated HTTP, just like load\\nrequests. This module does not construct snapshots or native decision receipts.\\n'",
          "'status'",
          "'completed'",
          "'status'",
