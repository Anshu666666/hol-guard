        "comments": [
          "# The public store getter reconstructs and validates the complete",
          "# native identity, including its optional command-extension binding."
        ],
        "lexical_except_grouping_and_commas": [
          [
            3,
            "'Private, bounded observation of real native receipts and journal I/O.\\n\\nWrappers call production functions unchanged. They retain only correlation IDs\\nand authenticated receipt fields, never hook text. An explicitly supplied SQLite\\nobserver adds separate VFS-level counters; the Python journal counters never imply\\nkernel or physical SQLite I/O coverage.\\n'"
          ],
          [
            1,
