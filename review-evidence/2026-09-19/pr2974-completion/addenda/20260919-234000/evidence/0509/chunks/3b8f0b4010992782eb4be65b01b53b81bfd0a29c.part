        "string_literals": [
          "'tests.bundle_first_cloud'",
          "'src'",
          "'support'",
          "'PYTHONPATH'",
          "''",
          "'PYTHONPATH'",
          "'Keep legacy unit fixtures on explicit, test-only oracle mode.\\n\\n    Production default remains ``auto``. Native-authority tests monkeypatch\\n    ``native_mode`` or delete this variable themselves. The oracle is injected\\n    below; no production module imports the semantic evaluator.\\n    '",
          "'HOL_GUARD_NATIVE'",
          "'HOL_GUARD_NATIVE'",
          "'off'",
          "'Install the Python reviewer only for explicit differential-test paths.'",
          "'HOL_GUARD_TEST_MODE'",
          "'1'",
          "'HOL_GUARD_PYTHON_ORACLE'",
          "'1'",
          "'HOL_GUARD_NATIVE_DIAGNOSTIC'",
          "'1'",
          "'_test_python_oracle_factory'",
          "'_test_source_ref_oracle'",
          "'--validate-test-invariants'",
          "'store_true'",
          "'fail collection when a protected invariant no longer resolves to a concrete test'",
          "'--validate-test-invariants'",
          "', '",
          "'daemon-state.json'",
          "\"Retire Guard daemons launched from the completed test's temporary tree.\"",
          "'tmp_path'",
          "'Undo any _resolve_guard_sync_auth_context override leaked by _seed_guard_cloud.'",
          "'_resolve_guard_sync_auth_context'",
          "\"Keep lifecycle authorization independent from the developer's real Guard state.\"",
          "'lifecycle-authority'",
          "'trusted_user_home'",
          "\"Clear trust attestation env vars so tests don't inherit the developer's shell config.\"",
          "'GUARD_AIBOM_TRUST_ATTESTATION_V2'",
          "'GUARD_AIBOM_TRUST_ATTESTATION_PRIVATE_KEY'",
          "'GUARD_AIBOM_TRUST_ATTESTATION_KEY_ID'",
          "'GUARD_AIBOM_TRUST_ATTESTATION_HEADLESS_SHORT_LIVED'",
          "'Start daemon refresh workers only in tests that exercise them.'",
          "'daemon_aibom_refresh'",
          "'_start_aibom_inventory_refresh'",
          "'daemon_bundle_refresh'",
          "'_start_supply_chain_bundle_refresh'",
          "'daemon_headless_refresh'",
          "'_start_headless_cloud_sync'",
          "'daemon_headless_queue'",
          "'_queue_headless_cloud_sync'",
          "'status'",
          "'not_configured'",
          "'message'",
          "'Cloud sync is isolated for this test.'",
          "'daemon_service_workers'",
          "'start_command_queue_worker'",
          "'start_cloud_sync_sync_worker'",
          "'HOL_GUARD_TEST_KEYRING_FILE'",
          "''",
