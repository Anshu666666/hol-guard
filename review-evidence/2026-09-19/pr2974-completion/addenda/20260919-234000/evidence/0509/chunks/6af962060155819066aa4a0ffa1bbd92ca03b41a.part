        "comments": [
          "# The local-once MAC binds this exact native request digest.",
          "# Every live hook owns one exact request/authority. Pending queue",
          "# deduplication must never retarget or extend another waiter."
        ],
        "lexical_except_grouping_and_commas": [
          [
            3,
            "'Queue native PreToolUse review pauses on the local approval center.\\n\\nRust remains the semantic authority. This helper only records a resolvable\\nrequest so the user can allow or deny an already-decided review. Native-mode\\napproval reuse is bound to Rust-owned request evidence. Commands that can\\nexecute mutable local code are not eligible for Python-side retry reuse.\\n'"
