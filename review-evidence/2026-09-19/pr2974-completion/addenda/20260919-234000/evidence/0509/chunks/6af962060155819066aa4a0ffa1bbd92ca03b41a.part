        "string_literals": [
          "'Bind ordinary local review reuse to its verified native policy domain.'",
          "'native_review_policy_binding'",
          "'native_review_request_digest'",
          "'guard.native-review-policy-binding.v1'",
          "'Retain the Rust commitment to exact Codex input, source, and generation.\\n\\n    This is distinct from ordinary reusable-review policy binding. A renewed\\n    policy generation conservatively requires a new browser approval.\\n    '",
          "'harness'",
          "'codex'",
          "'event_name'",
          "'PreToolUse'",
          "'payload_kind'",
          "'payload_kind'",
          "'result'",
          "'request_digest'",
          "'Capture the verified current native command-policy domain.\\n\\n    Review reuse requires a typed receipt and exact command-extension binding.\\n    Missing or inconsistent binding evidence fails closed instead of creating\\n    an unbound approval domain. Receipt persistence is asynchronous and does\\n    not participate in this check.\\n    '",
          "'harness'",
          "'event_name'",
          "'PreToolUse'",
          "'payload_kind'",
          "'payload_kind'",
          "'result'",
          "'native_review_policy_binding_invalid'",
