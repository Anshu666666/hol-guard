        "string_literals": [
          "'Queue native PreToolUse review pauses on the local approval center.\\n\\nRust remains the semantic authority. This helper only records a resolvable\\nrequest so the user can allow or deny an already-decided review. Native-mode\\napproval reuse is bound to Rust-owned request evidence. Commands that can\\nexecute mutable local code are not eligible for Python-side retry reuse.\\n'",
          "'Pause a native review result and attach any queued approval metadata.'",
          "'deny'",
          "'block'",
          "'block'",
          "'native_review_policy_binding_invalid'",
          "'HOL Guard could not bind this review to its native policy.'",
          "'codex'",
          "'decision'",
          "'allow'",
          "'minimum_action'",
          "'allow'",
          "'policy_action'",
          "'allow'",
          "'approval_reuse_status'",
          "'accepted'",
          "'decision'",
          "'deny'",
          "'minimum_action'",
          "'block'",
          "'policy_action'",
          "'block'",
          "'reason_code'",
          "'native_review_queue_failed'",
          "'reason'",
          "'HOL Guard could not record this review for approval.'",
          "'prompted'",
          "'approval_center_url'",
          "'Persist one native review as an approval-center request.'",
          "'add_approval_request'",
          "'get_approval_request'",
          "'reason'",
          "'HOL Guard requires review before this action can execute.'",
          "'review'",
          "'artifact'",
          "'native_pre_tool'",
          "'project'",
          "'harness'",
          "'tool_call'",
          "'codex'",
          "'PreToolUse'",
          "'pre_execution_result'",
          "'review'",
          "'native_codex_wait_request_deduplicated'",
          "'consume_native_review_approval'",
          "'://'",
          "'shell_command'",
          "'network_request'",
          "'mcp_tool'",
          "'schema_version'",
          "'action_id'",
          "'harness'",
          "'event_name'",
          "'PreToolUse'",
          "'action_type'",
          "'workspace'",
          "'workspace_hash'",
          "'tool_name'",
          "'command'",
          "'prompt_excerpt'",
          "'prompt_text'",
          "'target_paths'",
          "'network_hosts'",
          "'mcp_server'",
          "'mcp_tool'",
          "'package_manager'",
          "'package_name'",
          "'pre_execution_result'",
          "'review'",
          "'get_runtime_state'",
          "'approval_center_url'",
