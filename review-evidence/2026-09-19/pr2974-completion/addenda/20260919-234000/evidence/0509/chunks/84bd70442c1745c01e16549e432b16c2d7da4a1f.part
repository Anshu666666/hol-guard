          "'function boundValue('",
          "'function boundedOutputText('",
          "'function referencedPayload('",
          "'function toolCallIdKey('",
          "'guard_payload_ref'",
          "\"mkdtempSync(join(tmpdir(), 'hol-guard-hook-payload-'))\"",
          "\"createCipheriv('aes-256-gcm', key, nonce)\"",
          "\"createHash('sha256').update(encrypted.ciphertext).digest('hex')\"",
          "\"encryption: 'aes-256-gcm'\"",
          "'if (value === undefined) return { value: undefined, truncated: false };'",
          "\"typeof value === 'bigint'\"",
          "'value.toString()'",
          "'new WeakSet<object>()'",
          "'[deep object omitted by HOL Guard]'",
          "'const boundedContent = boundValue(event.content);'",
          "'const boundedStdout = boundedOutputText(event.content);'",
          "\"const reviewedContent = outputTruncated ? [{ type: 'text', text: toolOutput }] : boundedContent.value;\"",
          "'boundedContent.truncated || boundedStdout.truncated'",
          "'boundedToolInput.truncated || boundedContent.truncated'",
          "'const boundedToolInput = boundValue('",
          "'const blockedToolResults = new Map<string, string>();'",
          "'pi.on(\"message_end\"'",
          "'const toolCallId = toolCallIdKey(event.toolCallId);'",
          "'function modelVisibleBlockedReason(reason: string, reasonCode?: string): string'",
          "'Do not retry the same tool call automatically'",
          "'reasonCode === \"guard_cli_recovery_timeout\"'",
          "'reasonCode === \"daemon_hook_deadline_exhausted\"'",
          "'const modelReason = modelVisibleBlockedReason(reason, response.reason_code);'",
