          "'workspace request observer scope invalid'",
          "'workspace request paths outside owned canonical root'",
          "'workspace request clock origin invalid'",
          "'time.monotonic'",
          "'injected_control_clock'",
          "'time.time'",
          "'injected_control_clock'",
          "'workspace request clock invalid'",
          "'workspace request wall clock invalid'",
