      "1e09b91ad173d4836c0665c745507475100c3bc67227bc1a7d5124d447dd1ac6": "FunctionDef(name='test_each_store_owner_can_be_imported_before_the_facade', args=arguments(posonlyargs=[], args=[arg(arg='owner', annotation=Name(id='str', ctx=Load()))], kwonlyargs=[], kw_defaults=[], defaults=[]), body=[Assign(targets=[Name(id='source_root', ctx=Store())], value=Subscript(value=Attribute(value=Call(func=Attribute(value=Call(func=Name(id='Path', ctx=Load()), args=[Attribute(value=Name(id='base', ctx=Load()), attr='__file__', ctx=Load())], keywords=[]), attr='resolve', ctx=Load()), args=[], keywords=[]), attr='parents', ctx=Load()), slice=Constant(value=2), ctx=Load())), Assign(targets=[Name(id='script', ctx=Store())], value=Constant(value='\\nimport importlib\\nimport json\\nimport sys\\nimport typing\\nfrom pathlib import Path\\n\\nsource_root = Path(sys.argv[1]).resolve()\\nsys.path.insert(0, str(source_root))\\nfacade_name = \"codex_plugin_scanner.guard.store_base\"\\nowner_name = \"codex_plugin_scanner.guard.\" + sys.argv[2]\\nimportlib.import_module(\"codex_plugin_scanner.guard\")\\nassert facade_name not in sys.modules\\nassert owner_name not in sys.modules\\nowner = importlib.import_module(owner_name)\\nfacade = importlib.import_module(facade_name)\\nassert Path(owner.__file__).resolve().is_relative_to(source_root)\\nassert Path(facade.__file__).resolve().is_relative_to(source_root)\\nfor name in json.loads(sys.argv[3]):\\n    value = getattr(owner, name)\\n    assert getattr(facade, name) is value\\n    assert value.__module__ == facade_name\\n    typing.get_type_hints(value)\\nassert facade.MigratingFallbackSecretStore.__bases__ == (facade.FallbackSecretStore,)\\nassert facade._chunks.__globals__[\"_ChunkT\"] is facade._ChunkT\\nassert typing.get_args(typing.get_type_hints(facade._chunks)[\"values\"]) == (facade._ChunkT,)\\n')), Assign(targets=[Name(id='result', ctx=Store())], value=Call(func=Attribute(value=Name(id='subprocess', ctx=Load()), attr='run', ctx=Load())