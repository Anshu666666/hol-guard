          "'HOL_GUARD_NATIVE_PHASE_INODE'",
          "'HOL_GUARD_NATIVE_PHASE_INODE'",
          "'counts'",
          "'received'",
          "'processes'",
          "'diagnostic'",
          "'closed'",
          "'diagnostic'",
          "'backpressure'",
          "'prior_export_loss_observed'",
          "'processes'",
          "'receiver_loss_observed'",
          "'counts'",
          "'refused'",
          "'native_backpressure_stderr'",
          "'descriptor_closed'",
          "'native_backpressure_admission'",
          "'all_fillers_closed'",
          "'diagnostic'",
          "'cap'",
          "'processes'",
          "'export_window_exhausted'",
          "'processes'",
          "'last_frame_ordinal'",
          "'processes'",
          "'run_state_when_last_sampled'",
          "'running'",
          "'processes'",
