        "string_literals": [
          "'Real default/diagnostic native processes; no emulated product or timing qualification.'",
          "'Linux native diagnostic lifecycle controls'",
          "'module'",
          "'default'",
          "'HOL_GUARD_NATIVE_PHASE_DEFAULT_BINARY'",
          "'diagnostic'",
          "'HOL_GUARD_NATIVE_PHASE_DIAGNOSTIC_BINARY'",
          "'both exact compiled native feature variants are required'",
          "'default'",
          "'diagnostic'",
          "'pidfd_open'",
          "'pidfd_send_signal'",
          "'linux'",
          "'persistent_client'",
          "'client_connect_inclusive'",
          "'client_authenticate'",
          "'client_request_write_flush'",
          "'client_committed_response_read'",
