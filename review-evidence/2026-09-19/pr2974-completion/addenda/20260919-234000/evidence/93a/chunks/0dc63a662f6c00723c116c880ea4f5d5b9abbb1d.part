        "string_literals": [
          "'Failure evidence for the owned diagnostic sender fixture.'",
          "'stderr_case'",
          "'complete'",
          "'oversize'",
          "b'owned-sender-failure'",
          "'complete'",
          "b'x'",
          "'import sys\\n'",
          "\"print('ready', flush=True)\\n\"",
          "'sys.stderr.buffer.flush()\\n'",
          "'raise SystemExit(7)\\n'",
          "'SENDER'",
          "'stderr'",
          "'unused-endpoint'",
          "b'sent\\n'",
          "'expected'",
          "b'sent\\n'",
          "'received'",
          "b''",
          "'stderr'",
