          "'passed'",
          "'diagnostic'",
          "'role'",
          "'processes'",
          "'persistent_client'",
          "'managed_resident'",
          "'complete_run'",
          "'qualification_complete'",
          "'counts'",
          "'received'",
          "'processes'",
