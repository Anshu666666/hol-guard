          "'from . import runtime_hook_evidence_writer as _writer'",
          "'# disconnected '",
          "''",
          "'utf-8'",
          "'utf-8'",
          "'return _evidence_operations.submit_native_decision_receipt(self, receipt)'",
          "'facade_import'",
          "'from . import runtime_hook_evidence_operations as _evidence_operations'",
          "'# disconnected '",
          "'facade_false'",
          "'return False'",
          "'facade_argument'",
          "'return _evidence_operations.submit_native_decision_receipt(self, dict(receipt))'",
