        "string_literals": [
          "'Mutation controls keep the moved admission body inside the receipt I/O gate.'",
          "'src/codex_plugin_scanner/guard/daemon/runtime_hook_evidence_writer.py'",
          "'src/codex_plugin_scanner/guard/daemon/runtime_hook_evidence_operations.py'",
          "'utf-8'",
          "'class RuntimeHookEvidenceWriter:\\n'",
          "'    def submit_native_decision_receipt(self, receipt):\\n'",
          "'        self._records.append(receipt)\\n'",
          "'        return True\\n'",
          "'utf-8'",
          "'self._records.append(receipt)'",
          "'self._connect()'",
          "'utf-8'",
