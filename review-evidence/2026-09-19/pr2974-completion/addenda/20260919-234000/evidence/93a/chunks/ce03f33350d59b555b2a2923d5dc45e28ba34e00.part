          "'facade_false'",
          "'facade_argument'",
          "'facade_nested'",
          "'facade_io'",
          "'missing_helper'",
          "'helper_'",
          "'utf-8'",
          "'submit_native_decision_receipt'",
          "'helper_sqlite'",
          "'helper_connect'",
          "'helper_persist'",
          "'helper_sqlite'",
          "'_writer.sqlite3.connect(\"unused.db\")'",
          "'helper_connect'",
          "'self._connect()'",
          "'helper_persist'",
          "'_writer.persist_native_decision_receipt(store=self._store, receipt=receipt)'",
          "'    '",
          "'\\n'",
