  "original_workflow": {
    "path": ".github/workflows/pr2974-intel-strip-comparison.yml",
    "mode": "100644",
    "type": "blob",
    "content": "name: PR2974 Intel strip comparison\n\non:\n  push:\n    branches:\n      - codex/pr2974-intel-strip-comparison\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: pr2974-intel-strip-comparison\n  cancel-in-progress: false\n\njobs:\n  compare:\n    name: One original Intel none and symbols pair\n    runs-on: macos-15-intel\n    timeout-minutes: 75\n    env:\n      INTEL_HARNESS: ${{ github.workspace }}/harness\n      INTEL_SOURCE: ${{ github.workspace }}/source\n      INTEL_EXPERIMENT_ROOT: ${{ runner.temp }}/pr2974-intel-strip-${{ github.run_id }}-${{ github.run_attempt }}\n    steps:\n      - name: Checkout exact runner\n        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10\n        with:\n          path: harness\n          ref: ${{ github.sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - name: Checkout frozen investigated source\n        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10\n        with:\n          path: source\n          ref: 9d37172d6bc1e1febeb9c7611a5a050ef5ea798a\n          fetch-depth: 0\n          persist-credentials: false\n      - name: Select Python\n        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405\n        with:\n          python-version: 3.12.10\n      - name: Select uv\n        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39\n        with:\n          version: 0.9.26\n          enable-cache: false\n      - name: Execute frozen diagnostic pair once\n        id: pair\n        continue-on-error: true\n        shell: bash\n        run: python -I -B \"$INTEL_HARNESS/ci/pr2974_intel_strip_comparison/entry.py\" validate\n      - name: Emit complete bounded original report projection\n        id: projection\n        if: always()\n        continue-on-error: true\n        shell: bash\n        run: python -I -B \"$INTEL_HARNESS/ci/pr2974_intel_strip_comparison/entry.py\" projection\n      - name: Retain all original reports\n        id: reports\n        if: always()\n        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a\n        with:\n          name: pr2974-intel-strip-original-reports-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ env.INTEL_EXPERIMENT_ROOT }}/reports/\n          if-no-files-found: error\n          retention-days: 30\n      - name: Retain full binary wheel source and environment archives\n        id: originals\n        if: always()\n        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a\n        with:\n          name: pr2974-intel-strip-complete-originals-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ env.INTEL_EXPERIMENT_ROOT }}/artifacts/\n          if-no-files-found: error\n          retention-days: 30\n      - name: Require original gates and complete retention\n        if: always()\n        shell: bash\n        env:\n          PAIR_OUTCOME: ${{ steps.pair.outcome }}\n          PROJECTION_OUTCOME: ${{ steps.projection.outcome }}\n          REPORT_OUTCOME: ${{ steps.reports.outcome }}\n          ORIGINAL_OUTCOME: ${{ steps.originals.outcome }}\n        run: |\n          python -I -B - <<'PY'\n          import json\n          import os\n          from pathlib import Path\n          terminal = Path(os.environ[\"INTEL_EXPERIMENT_ROOT\"]) / \"reports/terminal.json\"\n          outcomes = [os.environ[name] for name in (\n              \"PAIR_OUTCOME\", \"PROJECTION_OUTCOME\", \"REPORT_OUTCOME\", \"ORIGINAL_OUTCOME\")]\n          assert all(value == \"success\" for value in outcomes), outcomes\n          assert terminal.is_file(), \"Missing original terminal receipt\"\n          result = json.loads(terminal.read_bytes())\n          assert result[\"passed\"] is True, result.get(\"failures\")\n          assert result[\"qualification_complete\"] is False\n          assert result[\"production_candidate_eligible\"] is False\n          PY\n",
