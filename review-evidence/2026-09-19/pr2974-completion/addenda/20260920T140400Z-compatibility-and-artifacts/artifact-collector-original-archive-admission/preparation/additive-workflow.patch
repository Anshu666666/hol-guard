+        env:
+          SOURCE_SHA: ${{ github.sha }}
+          RULE_DIGEST: ${{ needs.linux-x64.outputs.rule_digest }}
+        run: |
+          VERSION=$(uv run --no-sync python scripts/sync_repo_version.py --check)
+          uv run --no-sync python -m scripts.ci.aggregate_native_wheel_artifacts \
+            --artifacts-dir native-matrix-input \
+            --version "$VERSION" \
+            --source-sha "$SOURCE_SHA" \
+            --rule-digest "$RULE_DIGEST" \
+            --output native-matrix-evidence.json
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        if: always()
+        with:
+          name: native-wheel-matrix-admission
+          path: native-matrix-evidence.json
+          if-no-files-found: error
