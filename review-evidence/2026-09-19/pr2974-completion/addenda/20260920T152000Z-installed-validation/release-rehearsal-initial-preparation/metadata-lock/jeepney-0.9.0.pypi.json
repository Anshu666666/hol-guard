{"info":{"author":null,"author_email":"Thomas Kluyver <thomas@kluyver.me.uk>","bugtrack_url":null,"classifiers":["Programming Language :: Python :: 3","Topic :: Desktop Environment"],"description":"Jeepney is a pure Python implementation of D-Bus messaging. It has an `I/O-free\n<https://sans-io.readthedocs.io/>`__ core, and integration modules for different\nevent loops.\n\nD-Bus is an inter-process communication system, mainly used in Linux.\n\nTo install Jeepney::\n\n    pip install jeepney\n\n`Jeepney docs on Readthedocs <https://jeepney.readthedocs.io/en/latest/>`__\n\n","description_content_type":"text/x-rst","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":null,"home_page":null,"keywords":null,"license":null,"license_expression":"MIT","license_files":["LICENSE"],"maintainer":null,"maintainer_email":null,"name":"jeepney","package_url":"https://pypi.org/project/jeepney/","platform":null,"project_url":"https://pypi.org/project/jeepney/","project_urls":{"Documentation":"https://jeepney.readthedocs.io/en/latest/","Source":"https://gitlab.com/takluyver/jeepney"},"provides_extra":["test","trio"],"release_url":"https://pypi.org/project/jeepney/0.9.0/","requires_dist":["pytest; extra == \"test\"","pytest-trio; extra == \"test\"","pytest-asyncio>=0.17; extra == \"test\"","testpath; extra == \"test\"","trio; extra == \"test\"","async-timeout; extra == \"test\" and python_version < \"3.11\"","trio; extra == \"trio\""],"requires_python":">=3.7","summary":"Low-level, pure Python DBus protocol wrapper.","version":"0.9.0","yanked":false,"yanked_reason":null},"last_serial":27684045,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"takowl"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"b8e6c353e9aaed0ed0144029556417fda23b64f344e718331907054ba05b8c62"},"digests":{"blake2b_256":"b2a3e137168c9c44d18eff0376253da9f1e9234d0239e0ee230d2fee6cea8e55","md5":"bbf9ae7ccdf8fc96ce087260daad67d3","sha256":"97e