+    let moved = fixture.root.with_extension("moved");
+    let result = read_checked(&fixture.path, 100, None, || {
+        fs::rename(&fixture.root, &moved).unwrap();
+        fs::DirBuilder::new()
+            .mode(0o700)
+            .create(&fixture.root)
+            .unwrap();
+    });
+    fs::remove_dir(&fixture.root).unwrap();
+    fs::rename(moved, &fixture.root).unwrap();
